{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classgraph.local/schema/stage1_frame.json",
  "title": "ClassGraph Stage 1 Frame",
  "description": "One record per processed video frame. Emitted as JSONL — one JSON object per line.",
  "type": "object",
  "required": ["frame_id", "timestamp_ms", "persons", "objects"],
  "additionalProperties": false,
  "properties": {
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-indexed frame index in the source video."
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Frame presentation time in milliseconds from video start."
    },
    "persons": {
      "type": "array",
      "description": "Detected students. Empty array if none detected.",
      "items": { "$ref": "#/$defs/person" }
    },
    "objects": {
      "type": "array",
      "description": "Detected relevant objects (phones, laptops, books).",
      "items": { "$ref": "#/$defs/object_detection" }
    }
  },

  "$defs": {
    "bbox": {
      "type": "array",
      "description": "Axis-aligned pixel bbox [x, y, w, h] with (x, y) as top-left.",
      "prefixItems": [
        { "type": "number", "minimum": 0 },
        { "type": "number", "minimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "landmark": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "person": {
      "type": "object",
      "required": ["track_id", "bbox", "confidence", "face", "head_pose"],
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "type": ["integer", "null"],
          "description": "Stable ID from Stage 2 tracker. Always null in Stage 1 output."
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "face": {
          "type": ["object", "null"],
          "required": ["bbox", "landmarks", "ear"],
          "additionalProperties": false,
          "properties": {
            "bbox": {
              "oneOf": [
                { "$ref": "#/$defs/bbox" },
                { "type": "null" }
              ]
            },
            "landmarks": {
              "oneOf": [
                {
                  "type": "array",
                  "items": { "$ref": "#/$defs/landmark" },
                  "minItems": 468,
                  "maxItems": 478
                },
                { "type": "null" }
              ]
            },
            "ear": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "head_pose": {
          "type": ["object", "null"],
          "required": ["yaw", "pitch", "roll", "gaze_label"],
          "additionalProperties": false,
          "properties": {
            "yaw":   { "type": "number", "minimum": -180, "maximum": 180 },
            "pitch": { "type": "number", "minimum": -180, "maximum": 180 },
            "roll":  { "type": "number", "minimum": -180, "maximum": 180 },
            "gaze_label": {
              "type": "string",
              "enum": ["teacher", "left", "right", "down", "back"]
            }
          }
        }
      }
    },
    "object_detection": {
      "type": "object",
      "required": ["cls", "bbox", "confidence"],
      "additionalProperties": false,
      "properties": {
        "cls": {
          "type": "string",
          "enum": ["cell phone", "laptop", "book"]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
